{
  "manifest_version": 3,
  "name": "Edge NM Automation",
  "version": "0.1.0",
  "description": "Native Messaging bridge for Python-driven DOM automation (no CDP/Selenium/Playwright).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Edge NM Automation",
    "default_popup": "popup.html"
  }
}
